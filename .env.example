APP_NAME="Flower Purchase Forecast"
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change_me

DATABASE_URL=sqlite:///./data/app.db

# MVP source: csv. Later: odata/http/excel.
ONEC_CONNECTION_TYPE=csv
ONEC_BASE_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_TIMEOUT_SECONDS=60
ONEC_PRODUCTS_PATH=
ONEC_SALES_PATH=
ONEC_STOCKS_PATH=
ONEC_PURCHASES_PATH=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENABLED=false
# Leave empty for direct OpenAI. For ProxyAPI use: https://api.proxyapi.ru/openai/v1
OPENAI_BASE_URL=

# Optional later, because OpenAI model does not browse by itself.
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPAPI_API_KEY=

DEFAULT_REGION=RU-BU
DEFAULT_CITY=Ulan-Ude
DEFAULT_TIMEZONE=Asia/Irkutsk

MVP_PRODUCT_CATEGORY="Гвоздика общ"
FORECAST_LEAD_DAYS=21
FORECAST_PERIOD_DAYS=7
TREND_LOOKBACK_WEEKS=16
SAFETY_STOCK_PERCENT=5
USABLE_STOCK_PERCENT=25
STOCK_SHELF_LIFE_DAYS=7

ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_SESSION_DAYS=7
ADMIN_BACKUP_DIR=./data/backups
